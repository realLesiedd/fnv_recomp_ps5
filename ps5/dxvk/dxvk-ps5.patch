diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index a35626f..534a517 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -3,6 +3,26 @@
 #include "dxvk_latency_builtin.h"
 #include "dxvk_latency_reflex.h"
 
+namespace dxvk {
+  /* fnv_recomp: the most recent device, for dxvk_fnv_stats (the game's performance overlay) */
+  static std::atomic<DxvkDevice*> g_fnvDevice = { nullptr };
+}
+
+/* fnv_recomp: counters for the game's own performance overlay, without DXVK's HUD.
+   out[0] GPU idle time (microseconds, since the device was made), out[1] shader-compile tasks done,
+   out[2] shader-compile tasks queued in all, out[3] graphics pipelines made. Returns how many were written. */
+extern "C" __attribute__((visibility("default"))) int dxvk_fnv_stats(uint64_t* out, int n) {
+  dxvk::DxvkDevice* dev = dxvk::g_fnvDevice.load();
+  if (!dev || n < 4)
+    return 0;
+  dxvk::DxvkStatCounters c = dev->getStatCounters();
+  out[0] = c.getCtr(dxvk::DxvkStatCounter::GpuIdleTicks);
+  out[1] = c.getCtr(dxvk::DxvkStatCounter::PipeTasksDone);
+  out[2] = c.getCtr(dxvk::DxvkStatCounter::PipeTasksTotal);
+  out[3] = c.getCtr(dxvk::DxvkStatCounter::PipeCountGraphics);
+  return 4;
+}
+
