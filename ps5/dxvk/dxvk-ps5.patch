diff --git a/src/wsi/ps5/wsi_platform_ps5.cpp b/src/wsi/ps5/wsi_platform_ps5.cpp
new file mode 100644
index 0000000..2f19457
--- /dev/null
+++ b/src/wsi/ps5/wsi_platform_ps5.cpp
@@ -0,0 +1,163 @@
+/* PS5 WSI for DXVK native (fnv_recomp).
+ *
+ * A jailbroken PS5 has one display (the TV) and no windowing system: the
+ * "window" DXVK is given is just a token, and the swap chain surface is a
+ * VK_KHR_display plane surface on the console's video output, provided by
+ * PS5_Mesa's RADV (mihawk-99). The display/plane/mode selection follows
+ * plume-ps5's createPs5DisplaySurface (Nazky, MIT license). */
+#if defined(DXVK_WSI_PS5)
+
+#include "../wsi_platform.h"
+#include "../wsi_window.h"
+#include "../wsi_monitor.h"
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+#include <vector>
+#include <cstring>
+
+extern "C" int sceSystemServiceHideSplashScreen();
+
+namespace dxvk::wsi {
+
+  /* size of the TV mode chosen when the surface was created; 4K until then */
+  static uint32_t g_ps5Width = 3840, g_ps5Height = 2160, g_ps5RefreshMilliHz = 60000;
+  static const HMONITOR g_ps5Monitor = reinterpret_cast<HMONITOR>(uintptr_t(1));
+
+  class Ps5WsiDriver : public WsiDriver {
+  public:
+    std::vector<const char *> getInstanceExtensions() override {
+      return { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_DISPLAY_EXTENSION_NAME };
+    }
+
+    HMONITOR getDefaultMonitor() override { return g_ps5Monitor; }
+    HMONITOR enumMonitors(uint32_t index) override { return index == 0 ? g_ps5Monitor : nullptr; }
+    HMONITOR enumMonitors(const LUID *[], uint32_t, uint32_t index) override { return enumMonitors(index); }
+
+    bool getDisplayName(HMONITOR, WCHAR (&Name)[32]) override {
+      static const char n[] = "\\\\.\\DISPLAY1";
+      for (size_t i = 0; i < sizeof n; i++) Name[i] = n[i];
+      return true;
+    }
+    bool getDesktopCoordinates(HMONITOR, RECT *pRect) override {
+      pRect->left = 0; pRect->top = 0; pRect->right = LONG(g_ps5Width); pRect->bottom = LONG(g_ps5Height);
+      return true;
+    }
+    bool getDisplayMode(HMONITOR m, uint32_t modeNumber, WsiMode *pMode) override {
+      if (modeNumber != 0) return false;
+      return getCurrentDisplayMode(m, pMode);
+    }
+    bool getCurrentDisplayMode(HMONITOR, WsiMode *pMode) override {
+      pMode->width = g_ps5Width;
+      pMode->height = g_ps5Height;
+      pMode->refreshRate = WsiRational{ g_ps5RefreshMilliHz, 1000 };
+      pMode->bitsPerPixel = 32;
+      pMode->interlaced = false;
+      return true;
+    }
+    bool getDesktopDisplayMode(HMONITOR m, WsiMode *pMode) override { return getCurrentDisplayMode(m, pMode); }
+    WsiEdidData getMonitorEdid(HMONITOR) override { return {}; }
+
+    void getWindowSize(HWND, uint32_t *pWidth, uint32_t *pHeight) override {
+      if (pWidth) *pWidth = g_ps5Width;
+      if (pHeight) *pHeight = g_ps5Height;
+    }
+    void resizeWindow(HWND, DxvkWindowState *, uint32_t, uint32_t) override {}
+    bool setWindowMode(HMONITOR, HWND, DxvkWindowState *, const WsiMode &) override { return true; }
+    bool enterFullscreenMode(HMONITOR, HWND, DxvkWindowState *, bool) override { return true; }
+    bool leaveFullscreenMode(HWND, DxvkWindowState *, bool) override { return true; }
+    bool restoreDisplayMode() override { return true; }
+    HMONITOR getWindowMonitor(HWND) override { return g_ps5Monitor; }
+    bool isWindow(HWND hWindow) override { return hWindow != nullptr; }
+    bool isMinimized(HWND) override { return false; }
+    bool isOccluded(HWND) override { return false; }
+    void updateFullscreenWindow(HMONITOR, HWND, bool) override {}
+
+    VkResult createSurface(HWND, PFN_vkGetInstanceProcAddr gipa, VkInstance instance, VkSurfaceKHR *pSurface) override {
+      sceSystemServiceHideSplashScreen();
+      auto enumDevices = reinterpret_cast<PFN_vkEnumeratePhysicalDevices>(gipa(instance, "vkEnumeratePhysicalDevices"));
+      auto getDisplays = reinterpret_cast<PFN_vkGetPhysicalDeviceDisplayPropertiesKHR>(gipa(instance, "vkGetPhysicalDeviceDisplayPropertiesKHR"));
+      auto getPlanes = reinterpret_cast<PFN_vkGetPhysicalDeviceDisplayPlanePropertiesKHR>(gipa(instance, "vkGetPhysicalDeviceDisplayPlanePropertiesKHR"));
+      auto getModes = reinterpret_cast<PFN_vkGetDisplayModePropertiesKHR>(gipa(instance, "vkGetDisplayModePropertiesKHR"));
+      auto createPlaneSurface = reinterpret_cast<PFN_vkCreateDisplayPlaneSurfaceKHR>(gipa(instance, "vkCreateDisplayPlaneSurfaceKHR"));
+      if (!enumDevices || !getDisplays || !getPlanes || !getModes || !createPlaneSurface) {
+        Logger::err("PS5 WSI: VK_KHR_display is not available");
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+      }
+      uint32_t n = 1;
+      VkPhysicalDevice gpu = VK_NULL_HANDLE;
+      if (enumDevices(instance, &n, &gpu) < 0 || gpu == VK_NULL_HANDLE) return VK_ERROR_INITIALIZATION_FAILED;
+
+      uint32_t displayCount = 0;
+      if (getDisplays(gpu, &displayCount, nullptr) != VK_SUCCESS || !displayCount) {
+        Logger::err("PS5 WSI: no display");
+        return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      std::vector<VkDisplayPropertiesKHR> displays(displayCount);
+      getDisplays(gpu, &displayCount, displays.data());
+      uint32_t planeCount = 0;
+      if (getPlanes(gpu, &planeCount, nullptr) != VK_SUCCESS || !planeCount) return VK_ERROR_INITIALIZATION_FAILED;
+      std::vector<VkDisplayPlanePropertiesKHR> planes(planeCount);
+      getPlanes(gpu, &planeCount, planes.data());
+
+      /* the first display with modes; prefer its 4K mode */
+      VkDisplayKHR display = VK_NULL_HANDLE;
+      VkDisplayModeKHR mode = VK_NULL_HANDLE;
+      VkDisplayModeParametersKHR params = {};
+      for (uint32_t i = 0; i < displayCount && mode == VK_NULL_HANDLE; i++) {
+        uint32_t modeCount = 0;
+        if (getModes(gpu, displays[i].display, &modeCount, nullptr) != VK_SUCCESS || !modeCount) continue;
+        std::vector<VkDisplayModePropertiesKHR> modes(modeCount);
+        if (getModes(gpu, displays[i].display, &modeCount, modes.data()) != VK_SUCCESS) continue;
+        display = displays[i].display;
+        mode = modes[0].displayMode;
+        params = modes[0].parameters;
+        /* every mode the driver offers, refresh in millihertz (59940 is 59.94 Hz, 119880 is 119.88 Hz) */
+        for (uint32_t m = 0; m < modeCount; m++)
+          Logger::info(str::format("PS5 WSI: mode ", m, ": ", modes[m].parameters.visibleRegion.width, "x",
+                                   modes[m].parameters.visibleRegion.height, " @ ", modes[m].parameters.refreshRate, " mHz"));
+        /* 3840x2160, preferring a refresh near 60 Hz: the driver lists a 119.88 Hz mode first when the title
+           declares high frame rate, and the game's frame cap is 30 or 60 */
+        bool found = false;
+        for (uint32_t m = 0; m < modeCount; m++) {
+          const VkDisplayModeParametersKHR &p = modes[m].parameters;
+          if (p.visibleRegion.width != 3840 || p.visibleRegion.height != 2160) continue;
+          bool near60 = p.refreshRate >= 59000 && p.refreshRate <= 61000;
+          if (!found || near60) { mode = modes[m].displayMode; params = p; found = true; }
+          if (near60) break;
+        }
+      }
+      if (mode == VK_NULL_HANDLE) {
+        Logger::err("PS5 WSI: no display mode");
+        return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      uint32_t plane = 0;
+      for (uint32_t i = 0; i < planeCount; i++)
+        if (planes[i].currentDisplay == VK_NULL_HANDLE || planes[i].currentDisplay == display) { plane = i; break; }
+
+      VkDisplaySurfaceCreateInfoKHR info = { VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR };
+      info.displayMode = mode;
+      info.planeIndex = plane;
+      info.planeStackIndex = planes[plane].currentStackIndex;
+      info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+      info.globalAlpha = 1.0f;
+      info.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+      info.imageExtent = params.visibleRegion;
+      g_ps5Width = params.visibleRegion.width;
+      g_ps5Height = params.visibleRegion.height;
+      if (params.refreshRate) g_ps5RefreshMilliHz = params.refreshRate;
+      Logger::info(str::format("PS5 WSI: TV mode ", g_ps5Width, "x", g_ps5Height, " @ ", g_ps5RefreshMilliHz, " mHz"));
+      return createPlaneSurface(instance, &info, nullptr, pSurface);
+    }
+  };
+
+  static bool createPs5WsiDriver(WsiDriver **driver) {
+    *driver = new Ps5WsiDriver();
+    return true;
+  }
+
+  WsiBootstrap Ps5WSI = { "PS5", createPs5WsiDriver };
+
+}
+
+#endif
